# ══════════════════════════════════════════
# أرحنا بها — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم
# ══════════════════════════════════════════

# ── التطبيق ──
APP_NAME=أرحنا بها
APP_VERSION=1.0.0
DEBUG=true

# ── قاعدة البيانات ──
# SQLite للتطوير:
DATABASE_URL=sqlite+aiosqlite:///./arihna_biha.db
# PostgreSQL للإنتاج:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/arihna_biha

# ── Google OAuth 2.0 ──
# أنشئ مشروع في Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Google Gemini API ──
# احصل على مفتاح من: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ── أوقات الصلاة (الموقع الافتراضي) ──
DEFAULT_LATITUDE=3.1390
DEFAULT_LONGITUDE=101.6869
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur
PRAYER_CALCULATION_METHOD=4

# ── الجدولة ──
ADHKAR_OFFSET_MINUTES=15
SYNC_DAYS_AHEAD=3
PRAYER_SYNC_CRON_HOUR=1
ADHKAR_SYNC_CRON_HOUR=2

# ── الأمان ──
SECRET_KEY=change-me-to-a-random-string-in-production

# ── الواجهة ──
FRONTEND_URL=http://localhost:3000
